{
  "manifest_version": 3,
  "name": "Padkit",
  "version": "0.5.0",
  "description": "Controller support for explicitly configured sites.",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "scripting"
  ],
  "host_permissions": [
    "https://*.firstroboticsim.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.firstroboticsim.com/*"
      ],
      "js": [
        "config.js",
        "core.js",
        "gamepad.js",
        "navigation.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": [
        "https://*.firstroboticsim.com/*"
      ],
      "js": [
        "config.js",
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "action": {
    "default_title": "Padkit",
    "default_popup": "popup.html"
  }
}
